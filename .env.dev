# SELISE Blocks — production/default configuration.
# Only client-safe values belong here. Never put BLOCKS_PASSWORD or an impersonated
# project token (PTOK) in a VITE_-prefixed variable.

# The API host MUST be same-site with the app domain, or the SSO session cookie is
# never stored and every cookie-based call (/iam/me, logout) 401s.
# App is served on dfqfhj.slsblx.com → registrable domain slsblx.com → blocksapi.slsblx.com
VITE_BLOCKS_API_URL=https://blocksapi.dev.slsblx.com

# Public project key (the project tenant id), sent as x-blocks-key on every Blocks call.
VITE_BLOCKS_PROJECT_KEY=D2d61e575239647a9820d1a44e398f52c

# OIDC client id from the project's blocks-oidc identity provider.
# Run `npm run blocks:configure-oidc` to create/read it, then paste it here.
VITE_BLOCKS_OIDC_CLIENT_ID=853e2935-0379-44f3-b6d0-ea63d88b28da

# Must match a registered redirectUri on the OIDC client byte-for-byte.
VITE_BLOCKS_REDIRECT_URI=https://dzcvil-ehxqx.dev.slsblx.com/login/callback

VITE_BLOCKS_HOSTED_LOGIN=true
# Build-pipeline probe: rendered ver