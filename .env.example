# Copy to .env and fill in. All values here are public/client-safe.
VITE_BLOCKS_API_URL=https://blocksapi.<your-registrable-domain>
VITE_BLOCKS_PROJECT_KEY=<project tenant id>
VITE_BLOCKS_OIDC_CLIENT_ID=<oidc clientId>
VITE_BLOCKS_REDIRECT_URI=https://<your-app-domain>/login/callback

# Offer the hosted Blocks login alongside the in-app password + social buttons.
# Default true; false hides the button (and stops requiring the two OIDC values above).
VITE_BLOCKS_HOSTED_LOGIN=true

# Local HTTPS dev server (put these in .env.local)
# VITE_DEV_DOMAIN=<your-app-domain>
# VITE_DEV_PORT=5173

# --- Optional test knobs (all public; each is also a Dockerfile ARG, so Blocks Release
# --- can set it through the repo's secret set) ----------------------------------------

# Localization modules the app renders from, comma separated. Default: common
# VITE_BLOCKS_I18N_MODULES=common

# Live notifications over the Logic notifier hub. `false` turns the connection off.
# VITE_BLOCKS_NOTIFIER_REALTIME=true
# Hub method names to listen on (the notification configuration's NotifyMethod).
# VITE_BLOCKS_NOTIFY_METHODS=ReceiveNotification

# Heartbeat monitor this deployment pings, and how often (seconds). Leave the interval
# empty to ping only from the Monitor page.
# VITE_BLOCKS_HEARTBEAT_ID=
# VITE_BLOCKS_HEARTBEAT_INTERVAL=60
# Gateway path of the Monitor service, if it is not /monitor/v4.
# VITE_BLOCKS_MONITOR_PATH=/monitor/v4

# Build metadata stamped into /version.json (Release does not inject these itself).
# VITE_GIT_SHA=
# VITE_GIT_BRANCH=
# VITE_BUILD_ID=
