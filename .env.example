# Copy to .env and fill in. All values here are public/client-safe.
VITE_BLOCKS_API_URL=https://blocksapi.<your-registrable-domain>
VITE_BLOCKS_PROJECT_KEY=<project tenant id>
VITE_BLOCKS_OIDC_CLIENT_ID=<oidc clientId>
VITE_BLOCKS_REDIRECT_URI=https://<your-app-domain>/login/callback

# Offer the hosted Blocks login alongside the in-app password + social buttons.
# Default true; false hides the button (and stops requiring the two OIDC values above).
VITE_BLOCKS_HOSTED_LOGIN=true

# Local HTTPS dev server (put these in .env.local)
# VITE_DEV_DOMAIN=<your-app-domain>
# VITE_DEV_PORT=5173
